# GeoJSON/ArcGIS/CSV de acidentes INFOCRIM no GeoSampa.
GEOSAMPA_ACCIDENTS_URL=

# CSV ou XLSX exportado da consulta de criminalidade da SSP-SP.
SSP_CRIME_DATA_URL=
# GeoJSON de distritos/bairros com propriedade nome/name/distrito.
SSP_DISTRICTS_GEOJSON_URL=
