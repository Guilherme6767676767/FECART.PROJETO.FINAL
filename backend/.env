# Sentinel IA Backend - Configuração de Ambiente
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Configuração de CORS (URLs do Frontend React/Vite)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000

# Provedores de Clima
# Chave gratuita OpenWeatherMap: https://openweathermap.org/api
OPENWEATHER_API_KEY=
HG_BRASIL_API_KEY=

# Tempo de Cache em Segundos (10 minutos)
WEATHER_CACHE_TTL_SECONDS=600
